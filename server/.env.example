# Database (required)
DATABASE_URL="postgresql://user:password@localhost:5432/albion?schema=pet_clinic"

# Server
PORT=8080
NODE_ENV=development

# JWT (required; use a random value of at least 32 characters in production)
JWT_SECRET=replace-with-a-random-64-character-secret
JWT_EXPIRES_IN=7d

# Public URLs and CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
APP_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Gemini API (optional - for AI features)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Google Drive OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/drive/callback

# Email reminders and invitations (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Albion Pet Clinic

# Firebase Admin SDK (optional)
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=
# Preferred for hosted environments: base64-encoded or raw JSON service account.
FIREBASE_SERVICE_ACCOUNT=
